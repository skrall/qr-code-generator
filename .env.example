# Copy to .env and fill in the passwords. docker-compose.yml reads .env for ${...}; .env is
# git-ignored, so nothing in it is committed.
#
#   cp .env.example .env

# Which database to run: h2 (the app alone, data in a volume) or postgres. Pick one; both app
# services publish the same port. `docker compose --profile postgres up` also works.
COMPOSE_PROFILES=h2

# The operator's sign-in password (user name: operator). Required. Never leave it at the
# published default, change-me-on-deploy.
QR_CODE_PASSWORD=

# The Postgres password, needed only by the postgres profile. The container refuses to start
# without one.
POSTGRES_PASSWORD=

# The address short links are built from. Phones must be able to reach it, so for scans from
# other devices use a LAN address or the name behind your reverse proxy, and publish the port
# beyond loopback in docker-compose.yml.
# APP_PUBLIC_BASE_URL=http://localhost:8080

# The host port the app is published on, on 127.0.0.1.
# APP_PORT=8080

# Sign-in mode: basic (default), oidc, header or none. See the README's Authentication section;
# oidc and header need more settings than this file carries.
# APP_SECURITY_MODE=basic

# More basic-mode users, comma-separated, sharing QR_CODE_PASSWORD. Viewers render codes and
# list links; operators may also create, edit and delete them.
# APP_SECURITY_VIEWER_USERS=alice,bob
# APP_SECURITY_OPERATOR_USERS=carol

# Override the image (default qr-code-generator:0.1.0-SNAPSHOT, from ./mvnw spring-boot:build-image).
# QR_CODE_IMAGE=
